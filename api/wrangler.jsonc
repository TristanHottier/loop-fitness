{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loop-fitness-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  // account_id is not stored here: set CLOUDFLARE_ACCOUNT_ID in your shell
  // (see app/README.md, "Wrangler CLI").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loop-fitness-db",
      "database_id": "fab09a4e-dfa9-496f-90fc-2a65376262a1"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
